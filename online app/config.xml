<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        id="com.kawla.store"
        version="1.0.0">

    <name>KAWLA STORE</name>

    <description>KAWLA STORE - Offline POS &amp; Inventory</description>

    <author email="admin@kawla.store">KAWLA STORE</author>

    <content src="index.html" />

    <icon src="resources/KAWLA_STORE_icon.png" />

    <access origin="*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />

    
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidLaunchMode" value="singleTop" />
    
    <!-- SPLASH SCREEN -->
    <preference name="SplashScreenBackgroundColor" value="#065822" />
    <preference name="SplashScreenDelay" value="1500" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="300" />


    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="android-compileSdkVersion" value="36" />
    
     <!--KAWLA STORE SPLASH LOGO -->
        <preference
            name="AndroidWindowSplashScreenAnimatedIcon"
            value="resources/KAWLA_STORE_icon.png" />

        <preference
            name="AndroidWindowSplashScreenIconBackgroundColor"
            value="#065822" />

    </platform>

</widget>